":["toru","hinana","madoka","koito"]},{"id":"s42_01060300_02","title":"绕路前行","cast":["toru","madoka"]},{"id":"s42_01060300_03","title":"发现翻唱","cast":["koito","madoka","hinana","toru"]},{"id":"s42_01060300_04","title":"少女的独白","cast":["toru"]},{"id":"s42_01060300_05","title":"外景安排","cast":["koito","hinana","madoka","toru"]},{"id":"s42_01060300_06","title":"剧本与失联","cast":["koito","madoka","toru","hinana"]},{"id":"s42_01060300_07","title":"到达旅馆","cast":["hinana","madoka","toru","koito"]},{"id":"s42_01060300_08","title":"现场相遇","cast":["toru","koito","hinana","madoka"]},{"id":"s42_01060300_99","title":"舞台上的飞入","cast":["toru","koito","hinana","madoka"]}]},{"id":"s42_01070100","title":"新曲中的恋爱挂合","summary":"日花和美琴准备新曲录音，歌词是恋爱挂合互动。美琴想起初学钢琴时被少女问诀窍，理由是“想弹给喜欢的人听”。日花因集中力不足在舞蹈课失误，独自留下练习。美琴想起往事，决定用表演表现喜欢的心情。新曲反响好，粉丝说两人像聊恋爱话题。美琴提议加入挂合动作，告知发布活动日程。","cast":["nichika","mikoto"],"episodes":[{"id":"s42_01070100_00","title":"新曲录音前","cast":["nichika","mikoto"]},{"id":"s42_01070100_01","title":"钢琴课回忆","cast":["mikoto"]},{"id":"s42_01070100_02","title":"歌词中的恋爱","cast":["mikoto","nichika"]},{"id":"s42_01070100_03","title":"舞蹈课失误","cast":["nichika","mikoto"]},{"id":"s42_01070100_04","title":"打工时的噩梦","cast":["nichika","mikoto"]},{"id":"s42_01070100_05","title":"录音前的紧张","cast":["nichika","mikoto"]},{"id":"s42_01070100_06","title":"想起的少女","cast":["mikoto"]},{"id":"s42_01070100_07","title":"美琴的往事","cast":["mikoto","nichika"]},{"id":"s42_01070100_08","title":"少女的恋爱理由","cast":["mikoto","nichika"]},{"id":"s42_01070100_99","title":"新曲反响","cast":["nichika","mikoto"]}]},{"id":"s42_01070200","title":"30年后的答案","summary":"七草日花与绯田美琴因音乐杂志采访主题“想要到达的地方”而思考。日花看到电视上出道30周年再结成的ふわちす表演，美琴也注意到。两人偶遇ふわちす并交流，听到她们说仍有人等待“欢迎回来”。日花在采访中坦白自己还不清楚，但想作为シーズ继续奔跑；美琴也说找不到答案，但不继续跑就无法到达。两人发现彼此有共同之处。","cast":["nichika","mikoto"],"episodes":[{"id":"s42_01070200_00","title":"电视上的ふわちす","cast":["nichika","mikoto"]},{"id":"s42_01070200_01","title":"杂志取材主题","cast":["mikoto","nichika"]},{"id":"s42_01070200_02","title":"偶遇ふわちす","cast":["mikoto","nichika"]},{"id":"s42_01070200_03","title":"向ふわちす打招呼","cast":["mikoto","nichika"]},{"id":"s42_01070200_04","title":"ふわちす的感慨","cast":["mikoto","nichika"]},{"id":"s42_01070200_05","title":"信号灯前的思考","cast":["nichika","mikoto"]},{"id":"s42_01070200_06","title":"不同的道路","cast":["nichika","mikoto"]},{"id":"s42_01070200_07","title":"杂志上的回答","cast":["mikoto","nichika"]},{"id":"s42_01070200_08","title":"日花的采访","cast":["nichika"]},{"id":"s42_01070200_99","title":"日花的真实想法","cast":["nichika","mikoto"]}]},{"id":"s42_01070300","title":"雾中牵手","summary":"绯田美琴回忆与七草日花组队初期：日花首次舞台摔倒，美琴问“对你来说偶像是什么”。之后美琴因日花与制作人互动增多而不安，又偶遇前搭档斑鸠路加。制作人让她看自己的优点、信任伙伴。美琴提议蒙眼表演，两人靠声音和呼吸练习配合，美琴感到像在雾中牵手行走。她问制作人组队理由，制作人说因为两人都拼命，希望她们一起活下去。","cast":["mikoto","hazuki","luca","nichika"],"episodes":[{"id":"s42_01070300_00","title":"夜雾中的回忆","cast":["mikoto","hazuki","luca"]},{"id":"s42_01070300_01","title":"初次见面","cast":["mikoto","nichika","hazuki"]},{"id":"s42_01070300_02","title":"日花的挣扎","cast":["nichika","mikoto"]},{"id":"s42_01070300_03","title":"首次舞台","cast":["mikoto","nichika"]},{"id":"s42_01070300_04","title":"变化与不安","cast":["mikoto","nichika"]},{"id":"s42_01070300_05","title":"路加的出现","cast":["mikoto","luca"]},{"id":"s42_01070300_06","title":"制作人的话","cast":["mikoto"]},{"id":"s42_01070300_07","title":"蒙眼表演提案","cast":["nichika","mikoto"]},{"id":"s42_01070300_08","title":"蒙眼练习","cast":["mikoto","nichika"]},{"id":"s42_01070300_99","title":"组队理由","cast":["mikoto","nichika"]}]},{"id":"s42_01080100","title":"花束与同窗会","summary":"铃木羽那因工作不能参加同窗会，向朋友道歉。她与郁田阳希突袭直播、送鲷鱼烧给斑鸠路加却被冷淡拒绝。阳希认为《ハナムケのハナタバ》是给所有变化送花束的歌。羽那被导演邀请上节目，又看到同窗会照片中出现コメティック，陷入沉思。之后她被女粉丝认出并自我介绍为コメティック的铃木羽那。","cast":["hana","haruki","luca"],"episodes":[{"id":"s42_01080100_00","title":"同窗会邀请","cast":["hana"]},{"id":"s42_01080100_01","title":"突袭直播","cast":["haruki","hana"]},{"id":"s42_01080100_02","title":"拍摄与关心","cast":["hana"]},{"id":"s42_01080100_03","title":"花束的含义","cast":["haruki","hana"]},{"id":"s42_01080100_04","title":"送鲷鱼烧","cast":["hana","luca","haruki"]},{"id":"s42_01080100_05","title":"收录结束","cast":["hana","luca","haruki"]},{"id":"s42_01080100_06","title":"路加的想法","cast":["hana"]},{"id":"s42_01080100_07","title":"导演的邀请","cast":["hana"]},{"id":"s42_01080100_08","title":"与朋友通话","cast":["hana"]},{"id":"s42_01080100_99","title":"同窗会照片与路加","cast":["hana","haruki"]}]},{"id":"s42_01080200","title":"黑色与白色","summary":"在音乐节目收录中，郁田阳希谈重新游泳，铃木羽那追问斑鸠路加和阳希最近重新开始的事。收录后，一位女音乐人追问路加是否再也不做索罗活动，路加沉默。节目展示阳希柔和的水彩画，造型师说羽那适合白色。路加翻看粉丝信，看着剥落的指甲油，之后去美甲店。活动前她提出古怪要求，上台前低声说“吵死了”，表示不管白或黑，自己只是要呐喊。","cast":["haruki","hana","luca"],"episodes":[{"id":"s42_01080200_00","title":"最近重新开始的事","cast":["haruki","hana","luca"]},{"id":"s42_01080200_01","title":"索罗时代的追问","cast":["luca"]},{"id":"s42_01080200_02","title":"水彩画与黑色印象","cast":["haruki","luca"]},{"id":"s42_01080200_03","title":"白色衣装与粉丝信","cast":["hana","luca"]},{"id":"s42_01080200_04","title":"粉丝信与剥落指甲","cast":["luca","hana","haruki"]},{"id":"s42_01080200_05","title":"久违的美甲店","cast":["luca","hana"]},{"id":"s42_01080200_06","title":"休息室的邻座","cast":["hana","luca"]},{"id":"s42_01080200_07","title":"活动前的古怪要求","cast":["luca"]},{"id":"s42_01080200_08","title":"开演前的通排","cast":["haruki","hana","luca"]},{"id":"s42_01080200_99","title":"上台前的叫喊","cast":["luca","hana"]}]},{"id":"s42_01080300","title":"描摹与复制","summary":"节目企划让各组合交换歌曲表演，对方组合提议完全复制对方表演。郁田阳希努力练习复制，对方指出她手部角度偏差，要求抹去コメティック的习惯。阳希向制作人报告并展示写实画作，提出改为描摹对方表演。正式收录完成，反响不错。阳希向斑鸠路加道歉，路加只回“是吗”。最后对方组合成员被发现带着阳希的限定周边泰迪熊，独白不敢坦白是粉丝。","cast":["haruki","luca","hana","producer"],"episodes":[{"id":"s42_01080300_00","title":"曲交换企划碰面","cast":["haruki","luca","hana"]},{"id":"s42_01080300_01","title":"复制练习与素描本","cast":["haruki","hana"]},{"id":"s42_01080300_02","title":"交换联络与批评","cast":["haruki"]},{"id":"s42_01080300_03","title":"制作人询问方针","cast":["producer","haruki","luca"]},{"id":"s42_01080300_04","title":"报告与写实课题","cast":["haruki","producer","luca"]},{"id":"s42_01080300_05","title":"提出描摹方案","cast":["haruki","producer","hana"]},{"id":"s42_01080300_06","title":"逐渐接近的复制","cast":["haruki","hana","luca","producer"]},{"id":"s42_01080300_07","title":"曲交换正式收录","cast":["haruki","hana"]},{"id":"s42_01080300_08","title":"播出后的反响","cast":["haruki","producer","luca","hana"]},{"id":"s42_01080300_99","title":"泰迪熊与推し","cast":["hana","producer","haruki","luca"]}]},{"id":"s42_01210100","title":"流势与队长","summary":"八宫巡、月冈恋钟、小宫果穗、市川雏菜组成ソニックハート，讨论队长人选。巡被建议考虑，练习中她建议不要只追求吻合而是制造“流势”，并答应当队长。衣装弄脏事件中雏菜缓和气氛，巡向雏菜坦白自己怀疑队长自觉不足，雏菜鼓励她。巡提议各自摆姿势，拍摄成功。演出因雷雨设备故障，巡请求重排站位，大家重新练习。演出在雨中完成，安可声不断，四人约定再一起演出。","cast":["meguru","kogane","kaho","hinana","producer"],"episodes":[{"id":"s42_01210100_00","title":"初次问候前","cast":["meguru","kogane","kaho","hinana"]},{"id":"s42_01210100_01","title":"谁来当队长","cast":["producer","meguru","kogane","hinana","kaho"]},{"id":"s42_01210100_02","title":"流势而非吻合","cast":["meguru","kaho","kogane","hinana"]},{"id":"s42_01210100_03","title":"衣装方案与个性","cast":["meguru","producer","kogane","kaho","hinana"]},{"id":"s42_01210100_04","title":"衣装弄脏事件","cast":["kogane","hinana","kaho"]},{"id":"s42_01210100_05","title":"队长自觉的烦恼","cast":["meguru","hinana"]},{"id":"s42_01210100_06","title":"各自姿势的提案","cast":["meguru","producer","kaho","kogane","hinana"]},{"id":"s42_01210100_07","title":"舞台演出讨论","cast":["meguru","producer","kogane","hinana","kaho"]},{"id":"s42_01210100_08","title":"雷雨中的重排","cast":["meguru","kogane","producer","kaho","hinana"]},{"id":"s42_01210100_99","title":"雷雨后的安可","cast":["meguru","kogane","kaho","hinana","producer"]}]},{"id":"s42_01220100","title":"小巷与旧歌","summary":"樱木真乃与郁田阳希为新曲采访谈各自看到的过去。真乃发现一条不可思议的小巷却不敢踏入，阳希提议一起去，两人找到复古喫茶店“喫茶とぽす”。阳希分享旧歌播放列表，真乃听到工作人员聊只靠网络知识装懂而沉默。制作人说无法全知过去，但过去的歌仍传到今天。两人在酒吧听常客争论旧曲今曲，常客说听者耳朵比新旧更重要。真乃希望歌声成为某人的归处。","cast":["mano","haruki","producer"],"episodes":[{"id":"s42_01220100_00","title":"看不见的景色","cast":["mano","haruki","producer"]},{"id":"s42_01220100_01","title":"不可思议的路地","cast":["mano","haruki","producer"]},{"id":"s42_01220100_02","title":"一起踏入小巷","cast":["mano","haruki"]},{"id":"s42_01220100_03","title":"喫茶とぽす","cast":["mano","haruki"]},{"id":"s42_01220100_04","title":"旧歌播放列表","cast":["mano","haruki"]},{"id":"s42_01220100_05","title":"知与届","cast":["producer","haruki","mano"]},{"id":"s42_01220100_06","title":"店主与传达","cast":["mano","haruki","producer"]},{"id":"s42_01220100_07","title":"酒吧里的旧曲争论","cast":["mano","haruki"]},{"id":"s42_01220100_08","title":"常客的回忆与开店","cast":["mano","haruki","producer"]},{"id":"s42_01220100_99","title":"疲惫常客与电视","cast":["mano","producer"]}]},{"id":"s42_01230100","title":"狼群的中心","summary":"制作人向朝日、摩美美、树里等介绍六人新ユニット，宣布中心是朝日。朝日向美琴求指点，美琴让她先找出问题。朝日描述疲惫到极限后进入安静之处的感觉，制作人讲狼为寻新群而流浪。朝日找不到狼的尾巴，练习后独自离开，众人分头寻找，美琴先找到她。朝日看到初雪，明白狼找到东西会想告诉别人，宣布自己能像狼一样跳舞。舞台上成员念出独行夜路的词句，朝日问是否听见她“一起玩”的声音。","cast":["producer","asahi","juri","mamimi","mikoto","luca","madoka"],"episodes":[{"id":"s42_01230100_00","title":"狼群新ユニット","cast":["producer","asahi","juri","mamimi"]},{"id":"s42_01230100_01","title":"中心宣布与狼意象","cast":["producer","asahi","juri","mikoto","luca"]},{"id":"s42_01230100_02","title":"朝日向美琴求指点","cast":["asahi","mikoto","luca","juri","mamimi"]},{"id":"s42_01230100_03","title":"朝日描述安静之地","cast":["producer","asahi","madoka","mamimi","juri","mikoto","luca"]},{"id":"s42_01230100_04","title":"采访追问中心理由","cast":["asahi","mikoto","producer","madoka"]},{"id":"s42_01230100_05","title":"朝日与摩美美逛街","cast":["asahi","mamimi","madoka","producer","mikoto"]},{"id":"s42_01230100_06","title":"树里与路加同行采访","cast":["juri","luca","mamimi","producer"]},{"id":"s42_01230100_07","title":"朝日找不到狼尾","cast":["asahi","mikoto","luca","juri","madoka"]},{"id":"s42_01230100_08","title":"初雪中找到答案","cast":["asahi","mikoto","juri","madoka","mamimi"]},{"id":"s42_01230100_99","title":"舞台上的群狼","cast":["producer","mamimi","juri","asahi","luca","mikoto","madoka"]}]},{"id":"s42_01240100","title":"交换眼睛","summary":"作家采访透与雾子，想听无意识浮现的意象，两人只说出食物，采访难以推进。雾子注意到电球将坏，向灯丝道晚安。透描述刀刃横切女人眼睛的影像。雾子掉了古书中的押花书签，想象原主人看见的景色。透讲电影里的绿闪，提议交换眼睛。雾子主动邀透交谈，描述窗中红气球飞走，透说没看到。两人到海边看日落，绿闪出现，两人都说看见了。雾子说日光送到她窗中，透说不是用眼睛，而是在还没有名字的地方。采访开始前，两人都说已聊了很多。","cast":["toru","kiriko","producer"],"episodes":[{"id":"s42_01240100_00","title":"采访中的食物意象","cast":["toru","kiriko","producer"]},{"id":"s42_01240100_01","title":"雾子与坏掉的电球","cast":["kiriko","producer"]},{"id":"s42_01240100_02","title":"透的煎蛋与幻象","cast":["toru"]},{"id":"s42_01240100_03","title":"古书中的押花","cast":["kiriko","producer"]},{"id":"s42_01240100_04","title":"绿闪与交换眼睛","cast":["toru","producer"]},{"id":"s42_01240100_05","title":"雾子主动邀透交谈","cast":["kiriko","toru","producer"]},{"id":"s42_01240100_06","title":"窗中红气球","cast":["kiriko","toru","producer"]},{"id":"s42_01240100_07","title":"车窗与彩虹","cast":["toru","kiriko","producer"]},{"id":"s42_01240100_08","title":"日没绿闪","cast":["toru","kiriko","producer"]},{"id":"s42_01240100_99","title":"开始前的窗与海","cast":["producer","toru","kiriko"]}]},{"id":"s42_01250100","title":"中心与可爱","summary":"制作人向冬优子说明新五人ユニット并让她当中心，宣布ユニット名“I'm a Cutie Finder”。节目录制中甜花紧张说不出话，冬优子接过试吃救场。冬优子看到网上批评她独占镜头，又因节目方要求把主持换成羽那而主动答应。羽那主持获好评，冬优子提议让出中心，制作人拒绝并问她是否本心。冬优子请求重新构成节目，介绍成员本身的可爱，并邀羽那一起去看舞台。制作人说正因她的坚持アイキュー才被接受。","cast":["fuyuko","producer","hana","chiyoko","nichika","tenka"],"episodes":[{"id":"s42_01250100_00","title":"冬优子被选为中心","cast":["fuyuko","producer","hana","chiyoko","nichika","tenka"]},{"id":"s42_01250100_01","title":"アイキュー成立","cast":["fuyuko","producer","chiyoko","hana","nichika","tenka"]},{"id":"s42_01250100_02","title":"节目企划与各自零食","cast":["fuyuko","nichika","hana","chiyoko","tenka","producer"]},{"id":"s42_01250100_03","title":"冬优子救场甜花","cast":["fuyuko","tenka","chiyoko"]},{"id":"s42_01250100_04","title":"网上批评与冬优子动摇","cast":["fuyuko","chiyoko","hana","nichika","producer","tenka"]},{"id":"s42_01250100_05","title":"节目要求换主持","cast":["fuyuko","producer","nichika"]},{"id":"s42_01250100_06","title":"羽那主持获好评","cast":["hana","nichika","chiyoko","tenka","fuyuko"]},{"id":"s42_01250100_07","title":"冬优子提出让位","cast":["fuyuko","producer"]},{"id":"s42_01250100_08","title":"改版节目与邀羽那","cast":["fuyuko","hana","chiyoko"]},{"id":"s42_01250100_99","title":"冬优子的理想与工作","cast":["fuyuko","producer"]}]},{"id":"s42_01260100","title":"彼岸与消逝","summary":"制作人宣布ユニット名“彼岸流”，成员们讨论变化与不变。灯织对千雪说剧本中先生像她，故事讲先生患病逐渐不能动。咲耶与夏叶谈论风铃的声音转瞬即逝，爱依拍摄水洼中制作人的足迹。灯织看到千雪饰演的老师手指颤抖，提出想写剧本。作者出现说想听千雪演出的感受。爱依领悟照片主题是已消失之物。众人看夜空，感慨一切如编织星空般延续。灯织感慨虽找不到不变之物，但此刻一瞬仍在。","cast":["chiyuki","producer","hiori","sakuya","natsuha","mei"],"episodes":[{"id":"s42_01260100_00","title":"彼岸流成立","cast":["chiyuki","producer","hiori","sakuya","natsuha","mei"]},{"id":"s42_01260100_01","title":"摄影与录音的余音","cast":["mei","sakuya","natsuha","producer","hiori"]},{"id":"s42_01260100_02","title":"千雪与灯织读剧本","cast":["hiori","chiyuki"]},{"id":"s42_01260100_03","title":"风铃与消逝的音","cast":["sakuya","natsuha","mei","producer","hiori"]},{"id":"s42_01260100_04","title":"折不断的粉笔","cast":["chiyuki","hiori","mei","producer"]},{"id":"s42_01260100_05","title":"校舍与编织","cast":["hiori","chiyuki"]},{"id":"s42_01260100_06","title":"彼岸花与无意义","cast":["hiori","sakuya","natsuha","chiyuki"]},{"id":"s42_01260100_07","title":"风铃与足迹","cast":["hiori","mei","chiyuki","producer","sakuya","natsuha"]},{"id":"s42_01260100_08","title":"星空与消逝之物","cast":["natsuha","mei","sakuya","chiyuki","producer","hiori"]},{"id":"s42_01260100_99","title":"不变的此刻","cast":["hiori","chiyuki","mei","producer","sakuya","natsuha"]}]},{"id":"s42_01270100","title":"弱い絆","summary":"三峰结华等四人组成ノーワンフィールアローン，讨论人际关系的窒息感。福丸小糸被同学请求担任学年集会顾问，勉强答应。三峰结华与杜野凛世在书店偶遇，感慨偶像工作离不开人与人的繋がり。练习中福丸小糸身体不适，大家决定休息。大崎甘奈发现朋友未读消息而失落，杜野凛世把书借给她。三峰结华在群组通知周末会议取消，让众人休息。夜晚户外聊天，三峰结华问大家如何应对窒息感，福丸小糸说景色像舞台，三峰结华觉得ゆるい繋がり刚好。制作人建议深呼吸，众人准备正式排练。","cast":["yuika","producer","amana","rinze","koito"],"episodes":[{"id":"s42_01270100_00","title":"新ユニット初会合","cast":["yuika","producer","amana","rinze","koito"]},{"id":"s42_01270100_01","title":"小糸的承诺","cast":["koito","amana"]},{"id":"s42_01270100_02","title":"书店偶遇","cast":["yuika","rinze"]},{"id":"s42_01270100_03","title":"呼吸练习与休息","cast":["yuika","koito"]},{"id":"s42_01270100_04","title":"凛世借书","cast":["amana","rinze"]},{"id":"s42_01270100_05","title":"日程变更","cast":["producer","rinze","koito","amana","yuika"]},{"id":"s42_01270100_06","title":"呼吸的疑问","cast":["yuika","producer","amana"]},{"id":"s42_01270100_07","title":"自主練と夜道","cast":["yuika","amana","producer"]},{"id":"s42_01270100_08","title":"弱い絆","cast":["yuika","koito","amana","rinze","producer"]},{"id":"s42_01270100_99","title":"弱い絆で","cast":["yuika","amana","producer","rinze","koito"]}]},{"id":"s42_01890100","title":"感谢之歌与家庭","summary":"七草日花在户外等待制作人时被虫袭，制作人迟到道歉并提到新曲是感谢家人的婚礼歌曲。日花对“感谢”反应冷淡，在事务所与市川雏菜相遇后忘拿收据赶回超市。杜野凛世偷听到制作人与七草叶月谈话，制作人表示想让日花幸福。排练室中大崎甘奈问日花父母建议，日花说父亲不在、母亲住院。声乐训练中教练指出日花唱歌习惯，说她的歌听起来不像感谢。日花失踪后制作人在偏僻处找到她，日花质问为何选她，制作人说直觉认为四人能做出好东西。杜野凛世和市川雏菜递上喉糖，制作人承诺全力支持日花作为偶像成功。众人在便利店听到新曲，路人误以为制作人与她们是可疑关系，日花急中生智扮作亲女，事后向甘奈道谢。","cast":["nichika","hinana","amana","rinze","hazuki"],"episodes":[{"id":"s42_01890100_00","title":"虫とケータリング","cast":["nichika"]},{"id":"s42_01890100_01","title":"ブライダルソング","cast":["nichika","hinana","amana","rinze"]},{"id":"s42_01890100_02","title":"レシートと家族","cast":["nichika","hinana"]},{"id":"s42_01890100_03","title":"凛世の立ち聞き","cast":["rinze","hazuki","hinana","nichika"]},{"id":"s42_01890100_04","title":"両親の話","cast":["amana","nichika"]},{"id":"s42_01890100_05","title":"ボイトレの注意","cast":["nichika","amana","hinana"]},{"id":"s42_01890100_06","title":"探しに行く","cast":["nichika","amana","hazuki"]},{"id":"s42_01890100_07","title":"エゴと本音","cast":["nichika"]},{"id":"s42_01890100_08","title":"マヌカハニー","cast":["nichika","rinze","hinana"]},{"id":"s42_01890100_99","title":"親子のふり","cast":["nichika","amana","rinze","hinana"]}]},{"id":"s42_01890200","title":"夜泳池的拍摄","summary":"制作人说明MV拍摄行程，拍摄在豪华酒店夜间泳池进行，田中摩美美和和泉爱依兴奋不已。拍摄顺利结束后，制作人宣布包场让大家自由享受。众人要求确认食物和天鹅船，和泉爱依给樱木真乃和绯田美琴拍照又加入合影。桑山千雪主持夜间泳池时装秀，介绍有栖川夏叶和铃木羽那出场。樱木真乃休息时与制作人交谈，说想按自己步调享受。樋口圆香和摩美美调侃制作人没穿泳装，两人去游泳。铃木羽那发现制作人闲着，问他工作是开还是关，两人干杯。铃木羽那召集大家拍集合写真，樋口圆香提议她来拍并让大家围住制作人。制作人手机差点进水，绯田美琴关心他并帮他擦脖子。众人开始水枪大战，制作人也被卷入，桑山千雪宣布惩罚游戏是跳舞，制作人被要求跳盆舞。樱木真乃和铃木羽那裹毛巾聊天，交换联系方式。拍摄结束后众人决定结束夜游，铃木羽那邀樱木真乃去大浴场。","cast":["natsuha","mamimi","mei","madoka","chiyuki","hana","mikoto","mano"],"episodes":[{"id":"s42_01890200_00","title":"ナイトプール撮影","cast":["natsuha","mamimi","mei","madoka","chiyuki","hana"]},{"id":"s42_01890200_01","title":"スワンボートと写真","cast":["mei","mikoto","mano","mamimi","natsuha","hana"]},{"id":"s42_01890200_02","title":"ナイトプールコレクション","cast":["mano","chiyuki","natsuha","hana","mei"]},{"id":"s42_01890200_03","title":"スワンフロート","cast":["madoka","mamimi","mei","natsuha"]},{"id":"s42_01890200_04","title":"羽那の乾杯","cast":["hana","mei","mano"]},{"id":"s42_01890200_05","title":"集合写真","cast":["madoka","hana","mei","chiyuki","mano","natsuha","mamimi"]},{"id":"s42_01890200_06","title":"スマホとタオル","cast":["mikoto"]},{"id":"s42_01890200_07","title":"水鉄砲バトル","cast":["chiyuki","natsuha","mamimi","mano","mei","madoka","hana"]},{"id":"s42_01890200_08","title":"岡山とチェイン","cast":["hana","mano"]},{"id":"s42_01890200_99","title":"撮影後の夜","cast":["mamimi","madoka","natsuha","mei","chiyuki","mano","mikoto","hana"]}]},{"id":"s42_01890300","title":"人鱼公主的觉悟","summary":"月冈恋钟宣布主演舞台《人鱼公主》，排练时导演指出她演的人鱼公主感受不到痛，恋钟解释想法被否定。制作人到排练场接人，园田智代子和芹泽朝日说合奏已结束，只有恋钟留下特训。恋钟在广播节目里读听众来信，激动反驳说努力一定会以某种形式得到回报。她在排练场误翻到过去人鱼公主角色甄选的档案，上面全是不合格，得知原本要甄选但因规模扩大改为邀请她。恋钟在排练中反复念着“泡”，说自己要把泡的思念背负起来。她高烧停排，昏睡中梦见过去参加甄选的场景，想起自己也曾是泡。大崎甘奈和风野灯织探病，恋钟当场要演给两人看被阻止，她说想连同痛一起往前走。病愈回到排练场，她坚持本番舞台绝不让出。首演大获成功，公演前夜她告诉制作人自己最后对王子说的是“最喜欢你”。","cast":["kogane","producer","chiyoko","asahi","luca","nichika","amana","hiori","toru"],"episodes":[{"id":"s42_01890300_00","title":"人魚姫のオーディション","cast":["kogane"]},{"id":"s42_01890300_01","title":"恋钟的难题","cast":["producer","kogane","chiyoko","asahi"]},{"id":"s42_01890300_02","title":"广播里的回信","cast":["kogane","producer"]},{"id":"s42_01890300_03","title":"不合格的文件","cast":["kogane"]},{"id":"s42_01890300_04","title":"泡与觉悟","cast":["kogane","luca","nichika"]},{"id":"s42_01890300_05","title":"高烧与旧梦","cast":["kogane","producer","amana","hiori"]},{"id":"s42_01890300_06","title":"病床上的演技","cast":["kogane","amana","hiori"]},{"id":"s42_01890300_07","title":"复归稽古场","cast":["kogane","producer","toru"]},{"id":"s42_01890300_08","title":"人鱼姫首演","cast":["kogane","producer"]},{"id":"s42_01890300_99","title":"最后的台词","cast":["kogane","producer"]}]}]}
