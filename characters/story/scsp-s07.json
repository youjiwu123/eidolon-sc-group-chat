id":"s07_18000000_01","title":"温柔的关心","cast":["fuyuko"]},{"id":"s07_18000000_02","title":"送来杂志","cast":["fuyuko"]},{"id":"s07_18000000_03","title":"受到刺激","cast":["fuyuko"]},{"id":"s07_18000000_04","title":"请教护肤方法","cast":["fuyuko"]},{"id":"s07_18000000_05","title":"聊得太投入","cast":["fuyuko"]},{"id":"s07_18000000_06","title":"推荐化妆视频","cast":["fuyuko"]},{"id":"s07_18000000_07","title":"分送可爱点心","cast":["fuyuko"]},{"id":"s07_18000000_08","title":"锻炼计划","cast":["fuyuko"]},{"id":"s07_18000000_09","title":"推荐憧憬者的视频","cast":["fuyuko"]},{"id":"s07_18000000_10","title":"容易丢东西","cast":["fuyuko"]}]},{"id":"s07_19000000","title":"爱依的直率关心","summary":"和泉爱依直率地夸赞对方妆容超帅并求教，分享自己觉得超棒的歌。她察觉对方没精神便主动提出倾听，又夸对方唱歌好听想多听。被问舞台建议时她给出「总会有办法的！」的乐观鼓励，还兴致勃勃分享搞笑节目，礼让对方先选慰问品，提议去卡拉OK，展示新美甲并分享写字诀窍。","cast":["mei"],"episodes":[{"id":"s07_19000000_01","title":"夸赞妆容","cast":["mei"]},{"id":"s07_19000000_02","title":"分享好歌","cast":["mei"]},{"id":"s07_19000000_03","title":"察觉低落","cast":["mei"]},{"id":"s07_19000000_04","title":"想再听歌","cast":["mei"]},{"id":"s07_19000000_05","title":"舞台建议","cast":[]},{"id":"s07_19000000_06","title":"聊搞笑节目","cast":["mei"]},{"id":"s07_19000000_07","title":"让对方先选","cast":["mei"]},{"id":"s07_19000000_08","title":"提议去卡拉OK","cast":["mei"]},{"id":"s07_19000000_09","title":"展示新美甲","cast":["mei"]},{"id":"s07_19000000_10","title":"写字的诀窍","cast":["mei"]}]},{"id":"s07_20000000","title":"透的随性相伴","summary":"浅仓透以随性的方式与对方相处：她递出现场收到的食物分享，邀请一起看视频应用，轻声笑着欢迎来电。她邀对方一起望窗外，提议顺路去便利店，坦白从早上起就想吃鸡蛋烧。她看电影犯困打哈欠，比出“グー”手势肯定今天的感觉，又主动借外套关心对方受凉，还叫住对方指出头上沾了叶子。","cast":["toru"],"episodes":[{"id":"s07_20000000_01","title":"递出食物","cast":["toru"]},{"id":"s07_20000000_02","title":"分享视频应用","cast":["toru"]},{"id":"s07_20000000_03","title":"欢迎来电","cast":["toru"]},{"id":"s07_20000000_04","title":"望向窗外","cast":["toru"]},{"id":"s07_20000000_05","title":"提议去便利店","cast":["toru"]},{"id":"s07_20000000_06","title":"想吃鸡蛋烧","cast":["toru"]},{"id":"s07_20000000_07","title":"看电影犯困","cast":["toru"]},{"id":"s07_20000000_08","title":"今天的感觉不错","cast":["toru"]},{"id":"s07_20000000_09","title":"借你外套","cast":["toru"]},{"id":"s07_20000000_10","title":"头上沾了叶子","cast":["toru"]}]},{"id":"s07_21000000","title":"圆香的别扭善意","summary":"樋口圆香问对方自家的人有没有添麻烦，表示有事可以直接告诉她。她对被找去商量感到意外，建议去问八云小姐，又答应帮忙转达但留了余地。听说对方什么都没吃，她共感式地提醒，承诺能帮就帮，递出优惠券时又嫌麻烦。被问浅仓在哪只含糊回答，解释只是家住得近，最后轻描淡写说自己只是有点困。","cast":["madoka"],"episodes":[{"id":"s07_21000000_01","title":"有没有添麻烦","cast":["madoka"]},{"id":"s07_21000000_02","title":"找错人商量","cast":["madoka"]},{"id":"s07_21000000_03","title":"失物问八云","cast":["madoka"]},{"id":"s07_21000000_04","title":"答应帮忙转达","cast":["madoka"]},{"id":"s07_21000000_05","title":"什么都没吃可不行","cast":["madoka"]},{"id":"s07_21000000_06","title":"能帮就帮","cast":["madoka"]},{"id":"s07_21000000_07","title":"优惠券要不要","cast":["madoka"]},{"id":"s07_21000000_08","title":"浅仓在哪","cast":["madoka"]},{"id":"s07_21000000_09","title":"只是家住得近","cast":["madoka"]},{"id":"s07_21000000_10","title":"只是有点困","cast":["madoka"]}]},{"id":"s07_22000000","title":"小糸的紧张搭话","summary":"福丸小糸结结巴巴地鼓起勇气问对方有没有自己能帮上忙的事，吞吞吐吐拿出点心作为搭话由头，又小心翼翼提出可以帮忙传话。她建议累了含颗糖，注意到对方手里的新书，犹豫着表达想试试训练。被吓到发出“ぴゃ”后连忙道歉，被夸奖时习惯性自谦说大家更厉害，最后找到共同话题并告知事务所慰问品有剩余。","cast":["koito"],"episodes":[{"id":"s07_22000000_01","title":"能帮上什么忙","cast":["koito"]},{"id":"s07_22000000_02","title":"要不要吃点心","cast":["koito"]},{"id":"s07_22000000_03","title":"有话可以带","cast":["koito"]},{"id":"s07_22000000_04","title":"累了就含颗糖","cast":["koito"]},{"id":"s07_22000000_05","title":"刚出的新书","cast":["koito"]},{"id":"s07_22000000_06","title":"训练的机会","cast":["koito"]},{"id":"s07_22000000_07","title":"被吓到的小糸","cast":["koito"]},{"id":"s07_22000000_08","title":"大家更厉害","cast":["koito"]},{"id":"s07_22000000_09","title":"那个节目看过","cast":["koito"]},{"id":"s07_22000000_10","title":"事务所的慰问品","cast":["koito"]}]},{"id":"s07_23000000","title":"雏菜的随性日常","summary":"市川雏菜用轻快的语气说开心做就好，好奇地问对方口红的牌子，随口分享食物。她夸尤阿熊可爱，因看推特没听清话而反问，又对便利店食物感兴趣。她撒娇说累了需要奖励，笑着宣布要休息，还得意炫耀浅仓透的指甲是雏菜涂的，最后满足地说对方看起来很开心那就好。","cast":["hinana"],"episodes":[{"id":"s07_23000000_01","title":"开心做就好","cast":["hinana"]},{"id":"s07_23000000_02","title":"口红是哪家的","cast":["hinana"]},{"id":"s07_23000000_03","title":"要不要吃一个","cast":["hinana"]},{"id":"s07_23000000_04","title":"可爱的尤阿熊","cast":["hinana"]},{"id":"s07_23000000_05","title":"在看推特","cast":["hinana"]},{"id":"s07_23000000_06","title":"便利店的好吃吗","cast":["hinana"]},{"id":"s07_23000000_07","title":"需要奖励","cast":["hinana"]},{"id":"s07_23000000_08","title":"雏菜要休息","cast":["hinana"]},{"id":"s07_23000000_09","title":"透前辈的指甲","cast":["hinana"]},{"id":"s07_23000000_10","title":"看起来很开心","cast":["hinana"]}]},{"id":"s07_24000000","title":"日花的干脆吐槽","summary":"七草日花先打预防针说没什么有趣话题，干脆地递上慰问品。被问推荐曲目时反问对方喜好，又愤愤不平吐槽搞笑节目评审离谱。她想起有传话要转达，对空口同情做家务辛苦的人回一句那来帮忙啊，顺手分享唱片店优惠券，提议一起去新开的店，还表示教做海报需要报酬，最后坦言完全不认识某位偶像。","cast":["nichika"],"episodes":[{"id":"s07_24000000_01","title":"没什么有趣话题","cast":["nichika"]},{"id":"s07_24000000_02","title":"请用慰问品","cast":["nichika"]},{"id":"s07_24000000_03","title":"推荐什么歌","cast":["nichika"]},{"id":"s07_24000000_04","title":"那个搞笑节目","cast":["nichika"]},{"id":"s07_24000000_05","title":"七草小姐的传话","cast":["nichika"]},{"id":"s07_24000000_06","title":"那来帮忙啊","cast":["nichika"]},{"id":"s07_24000000_07","title":"唱片店优惠券","cast":["nichika"]},{"id":"s07_24000000_08","title":"新店开张","cast":["nichika"]},{"id":"s07_24000000_09","title":"报酬条件","cast":["nichika"]},{"id":"s07_24000000_10","title":"不认识的偶像","cast":["nichika"]}]},{"id":"s07_25000000","title":"美琴的不甘与专注","summary":"绯田美琴看到某人的表现后感叹厉害，随即表示自己不能落后。她记得制作人说过休息也重要，却干脆拒绝慰问品，被问练习注意什么时一时答不上来。她认可某位偶像很有冲劲，建议编舞去问训练师、服装去问造型师，转述工作人员说某人受关注，确认自己出身北海道却说不算了解，最后说周末大概会在练习。","cast":["mikoto"],"episodes":[{"id":"s07_25000000_01","title":"不能认输","cast":["mikoto"]},{"id":"s07_25000000_02","title":"休息也重要","cast":["mikoto"]},{"id":"s07_25000000_03","title":"不需要慰问品","cast":["mikoto"]},{"id":"s07_25000000_04","title":"练习时的意识","cast":["mikoto"]},{"id":"s07_25000000_05","title":"有冲劲的偶像","cast":["mikoto"]},{"id":"s07_25000000_06","title":"编舞去问教练","cast":["mikoto"]},{"id":"s07_25000000_07","title":"工作人员的话题","cast":["mikoto"]},{"id":"s07_25000000_08","title":"北海道出身","cast":["mikoto"]},{"id":"s07_25000000_09","title":"衣服问造型师","cast":["mikoto"]},{"id":"s07_25000000_10","title":"周末在练习","cast":["mikoto"]}]},{"id":"s07_26000000","title":"路加的直率现实","summary":"斑鸠路加答应如果时间对得上可以看舞蹈，看到口红便反问对方是不是喜欢这种款式。她打哈欠喊困解释熬夜，看出对方状态不好就劝休息。她认同对方品味并主动分享播放列表，提议吃饭时立刻强调各付各的，说某张碟是看封面冲动买的。她知道那间工作室却答不上位置，最后对消沉的人说只能向前看。","cast":["luca"],"episodes":[{"id":"s07_26000000_01","title":"可以看舞蹈","cast":["luca"]},{"id":"s07_26000000_02","title":"口红的喜好","cast":["luca"]},{"id":"s07_26000000_03","title":"困死了","cast":["luca"]},{"id":"s07_26000000_04","title":"劝人休息","cast":["luca"]},{"id":"s07_26000000_05","title":"品味不错","cast":["luca"]},{"id":"s07_26000000_06","title":"分享歌单","cast":["luca"]},{"id":"s07_26000000_07","title":"吃饭AA制","cast":["luca"]},{"id":"s07_26000000_08","title":"封面冲动购买","cast":["luca"]},{"id":"s07_26000000_09","title":"知道工作室","cast":["luca"]},{"id":"s07_26000000_10","title":"只能向前看","cast":["luca"]}]},{"id":"s07_27000000","title":"羽那的轻松闲聊","summary":"铃木羽那感叹事务所零食是强诱惑，问对方制作人在哪，喊困说工作让作息乱掉。她假设睡过头从宿舍全力跑到事务所要几分钟，问早餐是面包派还是米饭派，自己看当天心情。她打听附近推荐，聊冈山时用桃太郎开场，忽然说闻到好闻的味道，问除虫是不是制作人处理，最后轻松承认睡前拉伸坚持不下去。","cast":["hana"],"episodes":[{"id":"s07_27000000_01","title":"事务所的零食","cast":["hana"]},{"id":"s07_27000000_02","title":"找不到制作人","cast":["hana"]},{"id":"s07_27000000_03","title":"作息乱掉","cast":["hana"]},{"id":"s07_27000000_04","title":"跑多久能到","cast":["hana"]},{"id":"s07_27000000_05","title":"早餐吃什么","cast":["hana"]},{"id":"s07_27000000_06","title":"附近推荐","cast":["hana"]},{"id":"s07_27000000_07","title":"桃太郎开场","cast":["hana"]},{"id":"s07_27000000_08","title":"好香的味道","cast":["hana"]},{"id":"s07_27000000_09","title":"谁来除虫","cast":["hana"]},{"id":"s07_27000000_10","title":"睡前拉伸","cast":["hana"]}]},{"id":"s07_28000000","title":"阳希的悠闲陪伴","summary":"郁田阳希在放松的日常里主动找对方聊天：一起看Twista视频、发现可爱东西、分享好闻的香薰，还递上蓬松柔软的毛毯让人摸。她一边提议开窗换气、动手收拾周围，一边问有没有能帮上忙的地方，叮嘱对方别太拼命。看到对方行动后她感叹厉害、说自己也被激起干劲，整段气氛从悠闲舒缓转向积极。","cast":["haruki"],"episodes":[{"id":"s07_28000000_01","title":"一起看视频","cast":["haruki"]},{"id":"s07_28000000_02","title":"发现可爱东西","cast":["haruki"]},{"id":"s07_28000000_03","title":"想帮忙分担","cast":["haruki"]},{"id":"s07_28000000_04","title":"悠闲度过","cast":["haruki"]},{"id":"s07_28000000_05","title":"别太拼命","cast":["haruki"]},{"id":"s07_28000000_06","title":"好闻的香薰","cast":["haruki"]},{"id":"s07_28000000_07","title":"收拾周围","cast":["haruki"]},{"id":"s07_28000000_08","title":"毛毯的触感","cast":["haruki"]},{"id":"s07_28000000_09","title":"提议换气","cast":["haruki"]},{"id":"s07_28000000_10","title":"被干劲感染","cast":["haruki"]}]},{"id":"s07_90000000","title":"叶月的支持日常","summary":"七草叶月在事务所向对方问候辛苦了，提到冰箱里放着今天的点心，又为今天没准备点心而道歉；她不小心睡着后连忙道歉。随后她问对方有没有缺的备品要去采购，说明自己之后有预定无法陪同，提醒别忘了申请交通费和经费。听说对方要练跑，她提议骑自行车伴跑，并强调休息也是偶像工作、在背后支持偶像闪耀正是自己的职责。","cast":["hazuki"],"episodes":[{"id":"s07_90000000_01","title":"例行问候","cast":["hazuki"]},{"id":"s07_90000000_02","title":"冰箱里的点心","cast":["hazuki"]},{"id":"s07_90000000_03","title":"今天没有点心","cast":["hazuki"]},{"id":"s07_90000000_04","title":"不小心睡着","cast":["hazuki"]},{"id":"s07_90000000_05","title":"采购备品","cast":["hazuki"]},{"id":"s07_90000000_06","title":"今日有约","cast":["hazuki"]},{"id":"s07_90000000_07","title":"经费申请提醒","cast":["hazuki"]},{"id":"s07_90000000_08","title":"骑车伴跑","cast":["hazuki"]},{"id":"s07_90000000_09","title":"休息也是工作","cast":["hazuki"]},{"id":"s07_90000000_10","title":"支持者的职责","cast":["hazuki"]}]}]}
