# 密钥与本机配置
.env
.env.*
!.env.example
.claude/settings.local.json

# impeccable 的平台二进制按需下载（启动脚本会自动取对应平台的版本）；.claude/skills/ 下的技能都是指向 .agents/skills/ 的链接
.agents/skills/impeccable/scripts/bin/

# 其他 agent 工具的本机安装
.dsh/
.pi/
.impeccable/
skills-lock.json

# 浏览器调研产物
.playwright-mcp/


# 剧情库的原始数据和整理后的数据库都不进仓库（ADR-0003）
/corpus/
# 活动名对照表属于部署配置，只保留示例
deploy/event-names.toml
# 每周同步剧情库的日志（deploy/story-sync.sh）
/logs/

# 百炼语音识别测量用的录音（.scratch/bailian-stt ticket 01），不进仓库
/.scratch/bailian-stt/prototype/audio/
# 识别热词实测用的合成录音（.scratch/retrieval-and-hotwords 票 04），不进仓库
/.scratch/retrieval-and-hotwords/prototype/audio/
# 照片 tag 校对用的脸部对照图和缩略图拼版（.scratch/photos 票 13），是原作立绘，不进仓库（ADR-0003）
/.scratch/_faces/
/.scratch/photos/prototype/tags/contact_sheet.png

__pycache__/

# 研究记录与实验产物：仓库里已有的保留，新的不再提交
/.scratch/

# 原声音频（版权归原作方，体积也大）：不进仓库，部署时自备
characters/voices/

# 后台保存提示词时自动生成的历史备份
characters/backups/

# 前端构建缓存（下载的字体源文件）
/frontend/.cache/
